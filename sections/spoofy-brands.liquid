{%- assign s = section.settings -%}
<div class="sp-section{% if s.background == 'sand' %} sp-section--sand{% endif %}">
  <div class="sp-wrap">
    {%- render 'spoofy-head', eyebrow: s.eyebrow, title: s.title -%}
    <ul class="sp-brands" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li {{ block.shopify_attributes }}>
          {%- if b.link != blank -%}<a class="sp-brand" href="{{ b.link }}">{%- else -%}<div class="sp-brand">{%- endif -%}
            {%- if b.image != blank -%}
              {%- assign sp_brand_alt = b.name | default: b.image.alt -%}
              {{ b.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '160, 240, 480', sizes: '(min-width: 900px) 180px, 30vw', alt: sp_brand_alt }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          {%- if b.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Spoofy brands",
  "class": "sp-brands-section",
  "max_blocks": 18,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Script line", "default": "trusted" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Brands we love" },
    { "type": "select", "id": "background", "label": "Background", "options": [{ "value": "ivory", "label": "Ivory" }, { "value": "sand", "label": "Sand" }], "default": "ivory" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Brand name", "info": "Read out by screen readers." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Spoofy brands", "blocks": [{ "type": "brand" }, { "type": "brand" }, { "type": "brand" }] }]
}
{% endschema %}
