{%- comment -%}
  Spoofy redesign: a heading with a row of rounded "pill" links.
  Used on the homepage for "Shop by price"; reusable anywhere via the theme editor.
{%- endcomment -%}
<div
  id="{{ section.id }}"
  class="spoofy-pills hdt-relative"
  color-scheme="{{ section.settings.color_scheme }}"
  style="--sp-pt: {{ section.settings.padding_top }}px; --sp-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="hdt-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="spoofy-pills__heading hdt-h4">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="spoofy-pills__text">{{ section.settings.text }}</div>
    {%- endif -%}
    <ul class="spoofy-pills__list" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a class="spoofy-pills__link" href="{{ block.settings.link | default: '#' }}">
            {{- block.settings.label | escape -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Pill links",
  "class": "hdt-section spoofy-pills-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by price" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Under ₹999" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pill links",
      "blocks": [
        { "type": "link", "settings": { "label": "Under ₹999" } },
        { "type": "link", "settings": { "label": "Under ₹1,999" } },
        { "type": "link", "settings": { "label": "Under ₹2,999" } }
      ]
    }
  ]
}
{% endschema %}
