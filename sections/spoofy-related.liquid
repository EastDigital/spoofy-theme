{%- assign s = section.settings -%}
<div class="sp-section{% if s.background == 'sand' %} sp-section--sand{% endif %}"
  data-sp-recs
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent=related"
  {% unless recommendations.performed and recommendations.products_count > 0 %}hidden{% endunless %}>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="sp-wrap">
      {%- render 'spoofy-head', eyebrow: s.eyebrow, title: s.title -%}
      <div class="sp-rail" data-sp-rail>
        <div class="sp-rail__nav">
          <button type="button" class="sp-rail__btn" data-sp-rail-btn="prev"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 2L4 8l6 6"/></svg><span class="sp-vh">Previous products</span></button>
          <button type="button" class="sp-rail__btn" data-sp-rail-btn="next"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2l6 6-6 6"/></svg><span class="sp-vh">Next products</span></button>
        </div>
        <div class="sp-rail__track" data-sp-rail-track tabindex="0" role="group" aria-label="{{ s.title | escape }}">
          {%- for product in recommendations.products -%}
            {%- render 'spoofy-card', product: product, show_vendor: true, quick_add: s.quick_add -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Spoofy related products",
  "class": "sp-related-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Script line", "default": "you may also like" },
    { "type": "text", "id": "title", "label": "Heading", "default": "People Also Bought" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 10, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "quick_add", "label": "Show add to cart button", "default": true },
    { "type": "select", "id": "background", "label": "Background", "options": [{ "value": "ivory", "label": "Ivory" }, { "value": "sand", "label": "Sand" }], "default": "sand" }
  ]
}
{% endschema %}
