{%- assign s = section.settings -%}
<div class="sp-section{% if s.background == 'sand' %} sp-section--sand{% endif %}">
  <div class="sp-wrap">
    {%- render 'spoofy-head', eyebrow: s.eyebrow, title: s.title, text: s.text -%}
    <div class="sp-tiles" style="--sp-cols: {{ section.blocks.size | at_most: s.columns | at_least: 1 }}; --sp-ratio: {{ s.ratio }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <a class="sp-tile" href="{{ b.link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="sp-tile__media">
            {%- render 'spoofy-img', image: b.image, sizes: '(min-width: 768px) 50vw, 100vw', alt: b.title, placeholder: 'collection-1' -%}
          </div>
          <div class="sp-tile__body">
            {%- if b.eyebrow != blank -%}<span class="sp-eyebrow">{{ b.eyebrow | escape }}</span>{%- endif -%}
            {%- if b.title != blank -%}<h3 class="sp-title">{{ b.title | escape }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<p class="sp-tile__text">{{ b.text | escape }}</p>{%- endif -%}
            {%- if b.cta != blank -%}<span class="sp-link">{{ b.cta | escape }}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Spoofy image tiles",
  "class": "sp-tiles-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Script line" },
    { "type": "text", "id": "title", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "select", "id": "ratio", "label": "Image shape", "options": [{ "value": "auto", "label": "Natural (no cropping)" }, { "value": "4 / 3", "label": "Landscape" }, { "value": "1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "16 / 9", "label": "Wide" }], "default": "auto" },
    { "type": "select", "id": "background", "label": "Background", "options": [{ "value": "ivory", "label": "Ivory" }, { "value": "sand", "label": "Sand" }], "default": "ivory" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Script line", "default": "for your" },
        { "type": "text", "id": "title", "label": "Heading", "default": "Dogs" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "cta", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Spoofy image tiles", "blocks": [{ "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
