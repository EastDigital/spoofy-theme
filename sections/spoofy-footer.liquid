{%- assign s = section.settings -%}
<footer class="sp-footer">
  {%- if s.show_newsletter -%}
    <div class="sp-footer__news">
      <div class="sp-wrap">
        {%- render 'spoofy-head', eyebrow: s.news_eyebrow, title: s.news_title, text: s.news_text -%}
        {%- form 'customer', id: 'SpoofyNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="sp-footer__msg" role="status">Thank you for subscribing.</p>
          {%- elsif form.errors -%}
            <p class="sp-footer__msg" role="alert">{{ form.errors.messages | first }}</p>
          {%- endif -%}
          <label class="sp-vh" for="SpoofyNewsletterEmail">Email address</label>
          <input id="SpoofyNewsletterEmail" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Your email address" autocomplete="email" required>
          <button type="submit" class="sp-btn">{{ s.news_button | escape }}</button>
        {%- endform -%}

      </div>
    </div>
  {%- endif -%}

  <div class="sp-wrap">
    <div class="sp-footer__cols">
      <div class="sp-footer__col sp-footer__col--brand">
        {%- if s.logo != blank -%}
          <a class="sp-footer__logo" href="{{ routes.root_url }}">
            {%- assign sp_flogo_alt = s.logo.alt | default: shop.name -%}
            {{ s.logo | image_url: width: 340 | image_tag: loading: 'lazy', widths: '170, 340', sizes: '170px', alt: sp_flogo_alt }}
          </a>
        {%- endif -%}
        {%- if s.contact_heading != blank -%}<h2 class="sp-footer__h">{{ s.contact_heading | escape }}</h2>{%- endif -%}
        <div class="sp-footer__contact">{{ s.contact }}</div>
        <div class="sp-footer__social">
          {%- if settings.social_instagram_link != blank -%}
            <a class="sp-icon-btn" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7.200A4.8 4.8 0 1012 16.8 4.8 4.8 0 0012 7.200zm0 7.900a3.1 3.1 0 110-6.2 3.1 3.1 0 010 6.200zM17 5.900a1.1 1.1 0 100 2.2 1.1 1.1 0 000-2.200zM16.3 2H7.700A5.7 5.7 0 002 7.700v8.600A5.7 5.7 0 007.7 22h8.600a5.7 5.7 0 005.7-5.700V7.700A5.7 5.7 0 0016.3 2zm4 14.300a4 4 0 01-4 4H7.700a4 4 0 01-4-4V7.700a4 4 0 014-4h8.600a4 4 0 014 4v8.600z"/></svg>
              <span class="sp-vh">Instagram</span>
            </a>
          {%- endif -%}
          {%- if s.facebook_link != blank -%}
            <a class="sp-icon-btn" href="{{ s.facebook_link }}" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21.900v-7.300h2.500l.4-3h-2.900V9.700c0-.9.3-1.5 1.5-1.500h1.500V5.600c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.800v2.300H8.100v3h2.500v7.300h2.900z"/></svg>
              <span class="sp-vh">Facebook</span>
            </a>
          {%- endif -%}
          {%- if s.whatsapp_link != blank -%}
            <a class="sp-icon-btn" href="{{ s.whatsapp_link }}" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.500a9.4 9.4 0 00-8 14.400L2.5 21.500l4.7-1.400A9.4 9.4 0 1012 2.500zm0 17.100c-1.5 0-2.9-.4-4.1-1.200l-.3-.2-2.7.800.8-2.6-.2-.300A7.7 7.7 0 1112 19.600zm4.3-5.700c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.100l-.7.900c-.1.2-.3.2-.5.100a6.3 6.3 0 01-3.1-2.700c-.2-.4.2-.4.6-1.2.100-.2 0-.3 0-.400l-.7-1.700c-.2-.5-.4-.4-.5-.400h-.500a.9.9 0 00-.7.3 2.8 2.8 0 00-.9 2.100c0 1.2.900 2.4 1 2.6.100.2 1.8 2.8 4.4 3.9 1.6.700 2.3.700 3.1.600.5-.1 1.4-.6 1.6-1.2.200-.6.2-1 .1-1.1 0-.1-.2-.2-.5-.300z"/></svg>
              <span class="sp-vh">WhatsApp</span>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- assign sp_menu = block.settings.menu -%}
        <div class="sp-footer__col" {{ block.shopify_attributes }}>
          <h2 class="sp-footer__h">{{ block.settings.heading | default: sp_menu.title | escape }}</h2>
          {%- if sp_menu != blank -%}
            <ul role="list">
              {%- for link in sp_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="sp-footer__bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ s.copyright | escape }}</div>
      {%- if s.show_payment -%}
        <ul class="sp-footer__pay" role="list" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Spoofy footer",
  "class": "sp-footer-section",
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "news_eyebrow", "label": "Script line", "default": "stay in touch" },
    { "type": "text", "id": "news_title", "label": "Heading", "default": "Sign Up for Email" },
    { "type": "richtext", "id": "news_text", "label": "Text" },
    { "type": "text", "id": "news_button", "label": "Button label", "default": "Subscribe" },
    { "type": "header", "content": "Contact" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "contact_heading", "label": "Heading", "default": "Get in touch" },
    { "type": "richtext", "id": "contact", "label": "Contact details" },
    { "type": "url", "id": "facebook_link", "label": "Facebook link" },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp link" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright", "label": "Copyright text", "default": "All rights reserved." },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ]
}
{% endschema %}
