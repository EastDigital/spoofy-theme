{%- comment -%}
  Responsive image or placeholder. Accepts: image, sizes, lazy (default true), placeholder, alt
{%- endcomment -%}
{%- if image != blank -%}
  {%- liquid
    assign sp_loading = 'lazy'
    if lazy == false
      assign sp_loading = 'eager'
    endif
    assign sp_alt = alt | default: image.alt | default: ''
    assign sp_sizes = sizes | default: '100vw'
  -%}
  {{ image | image_url: width: 2400 | image_tag: loading: sp_loading, widths: '400, 600, 800, 1000, 1400, 1800, 2400', sizes: sp_sizes, alt: sp_alt }}
{%- else -%}
  {{ placeholder | default: 'image' | placeholder_svg_tag }}
{%- endif -%}
